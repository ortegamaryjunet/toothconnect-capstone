{
  "expo": {
    "name": "ToothConnect",
    "slug": "toothconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6b614310-33eb-43e0-8e49-f77f48d598d4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capstone.toothconnect",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.capstone.toothconnect",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1a365d",
          "defaultChannel": "appointments-high"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "6b614310-33eb-43e0-8e49-f77f48d598d4"
      }
    },
    "owner": "maryjuneortega"
  }
}
