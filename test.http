POST http://localhost:4000/api/appointments
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo0LCJyb2xlIjoicmVjZXB0aW9uaXN0IiwiYnJhbmNoZXMiOlsxXSwiaWF0IjoxNzc4Mzk0MjQxLCJleHAiOjE3NzgzOTUxNDF9.er9PRkpYdeEX7O-zzP1GE5JLZT5RW3vR52bda4xUP4I
